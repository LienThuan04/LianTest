# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.
APP_NAME="LianHarman"
URL_CLIENT="http://localhost:3000" # URL of the frontend client application. Change to your actual frontend URL for CORS configuration and other integrations.

# Supabase connection string ----------------------------------------------------------------------------
# # Connect to Supabase via connection pooling
# DATABASE_URL="postgresql://postgres.abcxyz:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true" # if port 6543 doesn't work, try 5432 for direct connection
# # Direct connection to the database. Used for migrations
# DIRECT_URL="postgresql://postgres.abcxyz:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres" # If you are using Prisma version 7 or later, you no longer need to use this line.

# Prisma URL for Prisma Data API connection -------------------------------------------------------------
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key="
MODE="development"  # Set to production in production environment for optimized performance and security settings.
HOST="localhost"
PORT=8080
VERSION="1" # Application version, used in Swagger documentation and other places. Update as needed for your project.
GLOBAL_PREFIX="api" # Global prefix for all routes. Change as needed to organize your API endpoints.
SEED_DEMO_DATA=false # Set to true to also seed sample business data (subjects, groups, questions, exams) for a full demo run. Only applicable if SEED_DB is true.
NAME_ROLE_ADMIN="ADMIN" # Name of the admin role to be created during seeding. Change as needed.
NAME_ROLE_USER="USER" # Name of the user role to be created during seeding.
BCRYPT_SALT_ROUNDS=10 # Number of salt rounds for bcrypt hashing. Adjust as needed for security/performance balance.
DEFAULT_PASSWORD="123456" # Default password for seeded users. Change to a secure password in production. 
EXPORT_SWAGGER_API_JSON=true # Set to true to export the generated Swagger API documentation as a JSON file on application startup. The file will be saved in the project root directory with the name "swagger-api.json". This can be useful for integrating with API documentation tools or for sharing the API schema without exposing the live documentation endpoint. Change to false to disable this feature if not needed.

#________________________________________________________________________________________________________________________________________________________________________________________
# JWT_SECRET
JWT_ACCESS_TOKEN_SECRET="" # Secret key for signing JWT access tokens. Change to a secure random string in production.
JWT_ACCESS_EXPIRE="10m" # Expiration time for JWT access tokens. Adjust as needed (e.g., 15m, 1h).
ACCESS_TOKEN_COOKIE="access_token" # Cookie chứa JWT cho trang SSR hệ thi (JwtStrategy đọc từ cookie này).
# refresh token
JWT_REFRESH_TOKEN_SECRET="" # Secret key for signing JWT refresh tokens. Change to a secure random string in production.
JWT_REFRESH_EXPIRE="1d" # Expiration time for JWT refresh tokens. Adjust as needed (e.g., 7d, 30d).
NUMBER_OF_DEVICES=2 # Maximum number of devices/sessions allowed per user. Adjust as needed for security and user experience balance.
NAME_COOKIE_REFRESH_TOKEN_BROWSER="refreshToken" # Name of the cookie to store the refresh token. Change as needed.
LIST_ORIGIN_CORS="http://localhost:3000,http://localhost:5173" # Comma-separated list of allowed origins for CORS configuration. Adjust as needed for your frontend applications and development/production environments.
NAME_DEVICEID_CLIENT="deviceId" # Name of the header or cookie to store the device ID for session management. Change as needed.

# Supabase connection string (if using Supabase as your database)
SUPABASE_URL=https://xxxxx.supabase.co # URL for your Supabase instance. Change to your actual Supabase URL from the Supabase dashboard.
SUPABASE_KEY=eyJxxxx # API key for Supabase. Change to your actual API key from the Supabase dashboard. Keep this key secure and do not expose it in client-side code.
SUPABASE_NAME_BUCKET=  # Name of the Supabase storage bucket (PHẢI là PUBLIC) để lưu ảnh câu hỏi/đáp án/bài tự luận. DB chỉ lưu public URL.
LIMIT_UPLOAD_FILE_SIZEMB=50  # Giới hạn kích thước 1 file upload (MB). Áp cho Multer trên các route có ảnh (thêm/sửa câu hỏi, nộp bài tự luận).

# OTP configuration
OTP_EXPIRE=5m # Expiration time for OTP codes. Adjust as needed (e.g., 5m for 5 minutes).
OTP_LENGTH=6 # Length of the OTP code. Adjust as needed (e.g., 6 for a 6-digit code).
OTP_MAX_ATTEMPTS=5 # Maximum number of OTP verification attempts before requiring a new OTP. Adjust as needed for security and user experience balance.
OTP_RESEND_COOLDOWN=60s # Cooldown time between OTP resend requests. Adjust as needed (e.g., 30s for 30 seconds).

# Password reset token (JWT) — issued after OTP verified, used to set new password
JWT_PASSWORD_RESET_SECRET="" # Secret key for signing password reset JWT. Keep separate from access/refresh token secrets.
NAME_COOKIE_RESET_PASS_TOKEN="" # Name of the cookie to store the password reset token. Change as needed.
PASSWORD_RESET_EXPIRE="10m" # How long the reset window stays open after OTP verification (e.g., 15m).

# Oauth Google client api--------------------------------------------
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_HOST="smtp.gmail.com" # SMTP server for sending emails. Change to your email provider's SMTP server if not using Gmail.
EMAIL_AUTH_USER="" # Your email address for sending emails. Change to your actual email address.
EMAIL_FROM="" # The email address that will appear in the From field of sent emails. Change to your actual email address or a no-reply address as needed.
SUPPORT_EMAIL="" # Contact/support email shown inside email templates. Defaults to EMAIL_AUTH_USER if left empty in code fallback.
EMAIL_PORT=587 # SMTP port for sending emails. Change to your email provider's SMTP port if not using Gmail. Common ports are 587 for TLS and 465 for SSL.
# To get this password, go to the page (https://myaccount.google.com/security), search for "App passwords," create a password with a name of your choice, and copy and paste it here.
EMAIL_AUTH_PASS=""  

# redis cache memory
UPSTASH_REDIS_REST_URL="https://your-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""
# Optional: replace the complete editable seed dataset (see src/seed-db/data/README.md).
# SEED_DATA_DIR=./my-seed-data

# seed Data base control
SEED_DB=false
CLEAR_DB=false