<a class="skip-link" href="#main-container">Đến nội dung chính</a>
<!-- Header -->
<header id="page-header">
  <div class="content-header">
    <!-- Left Section -->
    <div>
      <button type="button" class="btn btn-alt-secondary me-1 d-lg-none" data-toggle="layout" data-action="sidebar_toggle" aria-label="Mở menu">
        <i class="fa fa-fw fa-bars"></i>
      </button>
      <button type="button" class="btn btn-alt-secondary me-1 d-none d-lg-inline-block" data-toggle="layout" data-action="sidebar_mini_toggle" aria-label="Thu gọn menu">
        <i class="fa fa-fw fa-ellipsis-v"></i>
      </button>


    </div>

    <div class="workspace-title"><strong><%= typeof Title !== "undefined" ? Title : "LianTest" %></strong><span>Không gian thi trực tuyến</span></div>
    <!-- END Left Section -->

    <!-- Right Section -->
    <div class="header-actions">
      <!-- Notifications Dropdown (port inc/notifications.php) — chỉ SV (nhóm quyền 2) -->
      <% if (typeof user !== 'undefined' && user && user.manhomquyen === 2) { %>
      <div data-action="join" class="dropdown d-inline-block">
        <button type="button" class="btn btn-alt-secondary btn-show-notifications" data-id="<%= user.id %>" id="page-header-notifications-dropdown" aria-label="Thông báo"
          data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <i class="fa fa-fw fa-bell" id="notification-bell-icon"></i>
          <span class="badge bg-danger" id="notification-count">0</span>
        </button>
        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0 notification-menu"
          aria-labelledby="page-header-notifications-dropdown">
          <div class="bg-primary-dark rounded-top fw-semibold text-white text-center p-3">
            Thông báo
          </div>
          <ul class="nav-items my-2 list-notifications">
            <!-- data -->
          </ul>
        </div>
      </div>
      <% } %>
      <!-- END Notifications Dropdown -->

      <!-- User Dropdown -->
      <div class="dropdown d-inline-block">
        <button type="button" class="btn btn-alt-secondary" id="page-header-user-dropdown" aria-label="Tài khoản" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <i class="far fa-fw fa-user-circle"></i>
          <i class="fa fa-fw fa-angle-down d-none opacity-50 d-sm-inline-block"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-end p-0" aria-labelledby="page-header-user-dropdown">
          <div class="bg-body-light rounded-top fw-semibold text-center p-3 border-bottom">
            <span class="avatar-Account">
              <%# Cột `avatar` có thể là TÊN FILE cũ hoặc URL Supabase (xem public/js/avatar-url.js) %>
              <% var headerAvatar = (typeof user !== 'undefined' && user.avatar) ? String(user.avatar) : 'avatar2.jpg'; %>
              <img class="img-avatar img-avatar48 img-avatar-thumb" src="<%= /^https?:\/\//i.test(headerAvatar) ? headerAvatar : '/public/media/avatars/' + headerAvatar %>" alt="" />
            </span>
            <div class="pt-2 load-nameAccount">
              <a class="fw-semibold"><%= typeof user !== 'undefined' ? user.hoten : '' %></a>
            </div>
          </div>
          <div class="p-2">
            <a class="dropdown-item" href="/account">
              <i class="si si-settings me-2 fa-fw icon-dropdown-item"></i> Tài khoản
            </a>
            <!-- Logout: stateless JWT nên chỉ cần POST xoá cookie (xem ExamAuthController.logout) -->
            <button type="submit" class="dropdown-item" form="logoutForm">
              <i class="si si-logout me-2 fa-fw icon-dropdown-item"></i> Đăng xuất
            </button>
            <form id="logoutForm" action="/auth/logout" method="post" class="d-none"></form>
          </div>
        </div>
      </div>
      <!-- END User Dropdown -->
    </div>
    <!-- END Right Section -->
  </div>

  <!-- Header Loader -->
  <div id="page-header-loader" class="overlay-header bg-header-dark">
    <div class="bg-white-10">
      <div class="content-header">
        <div class="w-100 text-center"><i class="fa fa-fw fa-sun fa-spin text-white"></i></div>
      </div>
    </div>
  </div>
</header>
<!-- END Header -->
