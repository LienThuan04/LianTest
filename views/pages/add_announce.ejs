<!DOCTYPE html>
<html lang="vi">
<head>
  <!-- Trang ở path sâu (/teacher_announcement/add|update/:matb) → base href để
       mọi URL tương đối resolve về gốc, như các trang chi tiết khác. -->
  <base href="/">
  <link rel="stylesheet" href="/public/js/plugins/sweetalert2/sweetalert2.min.css" />
<link rel="stylesheet" href="/public/js/plugins/select2/css/select2.min.css" />
<%- include('../partials/head') %>


</head>
<body class="page-add-announce">
  <div id="page-container" class="sidebar-o sidebar-light enable-page-overlay side-scroll page-header-fixed main-content-narrow">
    <%- include('../partials/navbar') %>
    <%- include('../partials/header') %>

    <!-- Main Container -->
    <main id="main-container">
      <!-- Port từ DHT_OneTest/mvc/views/pages/add_announce.php -->
      <div class="content py-5 bg-light">
        <div class="block block-rounded shadow-lg border-start border-5 border-primary">
          <div class="block-header bg-body-light text-white p-4 d-flex justify-content-between align-items-center">
            <h3 class="block-title mb-0">
              <i class="fa fa-paper-plane me-2"></i>
              <%= Action === 'create' ? 'Tạo mới và gửi thông báo' : 'Cập nhật thông báo' %>
            </h3>
          </div>

          <div class="block-content p-4">
            <form class="row g-0 flex-md-grow-1 form-taothongbao" onsubmit="return false;">
              <div class="col-12">
                <div class="mb-4">
                  <label for="name-exam" class="form-label fw-semibold">Nội dung thông báo</label>
                  <textarea class="form-control form-textarea-large" id="name-exam" name="name-exam" placeholder="Nhập nội dung thông báo"></textarea>
                </div>

                <div class="mb-4">
                  <div class="block block-rounded border">
                    <div class="block-header block-header-default d-flex align-items-center justify-content-between">
                      <h3 class="block-title mb-0">Thông báo cho</h3>
                      <div class="block-option">
                        <select class="js-select2 form-select border-primary" id="nhom-hp" name="nhom-hp" style="width: 300px" data-placeholder="Chọn nhóm học phần thông báo..." <%= Action === 'update' ? 'disabled' : '' %>>
                        </select>
                      </div>
                    </div>

                    <div class="block-content pb-3">
                      <div class="row" id="list-group" name="list-group">
                        <div class="text-center fs-sm"><img style="width:100px" src="/public/media/svg/empty-state.svg" alt=""></div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="mb-4">
                  <% if (Action === 'create') { %>
                    <button type="submit" class="btn btn-primary px-4 py-2" id="btn-send-announcement"><i class="fa fa-plus me-1"></i> Gửi thông báo</button>
                  <% } else { %>
                    <button type="submit" class="btn btn-primary px-4 py-2" id="btn-update-announce"><i class="fa fa-save me-1"></i> Cập nhật thông báo</button>
                  <% } %>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>

  <%- include('../partials/script') %>

  <script src="/public/js/plugins/jquery-validation/jquery.validate.min.js"></script>
  <script src="/public/js/plugins/jquery-validation/additional-methods.min.js"></script>
  <script src="/public/js/plugins/jquery-validation/localization/messages_vi.min.js"></script>
  <script src="/public/js/plugins/bootstrap-notify/bootstrap-notify.min.js"></script>
  <script src="/public/js/plugins/sweetalert2/sweetalert2.all.min.js"></script>
  <script src="/public/js/plugins/select2/js/select2.full.min.js"></script>
  <script src="/public/js/plugins/flatpickr/flatpickr.min.js"></script>

  <!-- Y như add_announce.php: trang TẠO dùng announcement.js, trang SỬA dùng
       update_announce.js (mỗi file tự khởi tạo validate + nạp nhóm học phần).
       Pagination chỉ khởi tạo khi trang có container danh sách. -->
  <% if (Action === 'update') { %>
  <script src="/public/js/pages/update_announce.js"></script>
  <% } else { %>
  <script src="/public/js/pages/announcement.js"></script>
  <% } %>
</body>
</html>
