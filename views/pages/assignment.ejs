      <!-- Modal: Chỉnh sửa phân công -->
      <div class="modal fade" id="modal-default-vcenter" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
          <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-body-light text-white">
              <h5 class="modal-title fw-bold">
                <i class="fa fa-edit me-2"></i> Chỉnh sửa phân công
              </h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="form-edit-assignment">
              <div class="modal-body p-4">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-primary">
                      <i class="fa fa-chalkboard-teacher me-2"></i> Giảng viên
                    </label>
                    <select class="js-select2 form-select border-primary" id="edit-giang-vien" required>
                      <option value="">Chọn giảng viên</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-primary">
                      <i class="fa fa-book-open me-2"></i> Môn học
                    </label>
                    <select class="js-select2 form-select border-primary" id="edit-mon-hoc" required>
                      <option value="">Chọn môn học</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-primary">
                      <i class="fa fa-calendar me-2"></i> Năm học
                    </label>
                    <select class="js-select2 form-select border-primary" id="edit-namhoc" required disabled>
                      <option value="">Chọn năm học</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-primary">
                      <i class="fa fa-clock me-2"></i> Học kỳ
                    </label>
                    <select class="js-select2 form-select border-primary" id="edit-hocky" required disabled>
                      <option value="">Chọn học kỳ</option>
                    </select>
                  </div>
                </div>
              </div>
              <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                  <i class="fa fa-times me-1"></i> Hủy
                </button>
                <button type="submit" class="btn btn-primary shadow-sm rounded-pill px-4">
                  <i class="fa fa-save me-1"></i> Lưu thay đổi
                </button>
              </div>
            </form>
          </div>
        </div>
