<!DOCTYPE html>
<html lang="vi">
<head>
<%- include("../../partials/head") %>
<link rel="stylesheet" href="/public/css/auth.css">
</head>
<body class="auth-page">
<a class="skip-link" href="#auth-main">Đến biểu mẫu</a>
<div id="page-container" class="auth-layout">
<%- include("../../partials/auth-intro") %>
<main class="auth-panel" id="auth-main">
<h1>Đăng nhập</h1><p>Truy cập không gian học tập và bài thi của bạn.</p>
<div id="loginError" class="alert" role="status" aria-live="polite"></div><form id="loginForm" method="POST">
            <div class="mb-3">
              <label class="form-label" for="login-id">Mã sinh viên / giảng viên</label>
              <input type="text" class="form-control form-control-lg shadow-sm" id="login-id" name="id" autocomplete="username" placeholder="Nhập mã sinh viên hoặc giảng viên" required />
            </div>
            <div class="mb-4">
              <label class="form-label" for="login-password">Mật khẩu</label>
              <input type="password" class="form-control form-control-lg shadow-sm" id="login-password" name="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required />
            </div>
            <div class="d-grid mb-3">
              <button id="loginBtn" type="submit" class="btn btn-lg btn-primary shadow-sm">
                <span class="btn-text">Đăng nhập</span>
              </button>
            </div>
            <div class="d-flex justify-content-between mt-4 small">
              <a class="text-muted" href="/auth/recover"><i class="fa fa-question-circle me-1"></i> Quên mật khẩu?</a>
              <a class="text-muted" href="/auth/signup"><i class="fa fa-user-plus me-1"></i> Tạo tài khoản</a>
            </div>
            <div class="text-center mt-4">
              <a href="/" class="btn btn-outline-secondary btn-sm px-4">
                <i class="fa fa-arrow-left me-1"></i> Quay lại trang chủ
              </a>
            </div>
          </form>
<span id="year-copy" class="visually-hidden"></span>
<p class="auth-footer"><a href="/">← Tìm hiểu LianTest</a></p>
</main></div>
<script>
    document.getElementById('year-copy').textContent = new Date().getFullYear();

    $(function () {
      $('#loginForm').on('submit', function (e) {
        e.preventDefault();
        const $btn = $('#loginBtn');
        const $text = $btn.find('.btn-text');
        const $err = $('#loginError');

        $btn.prop('disabled', true);
        $text.html('<i class="fa fa-spinner fa-spin me-2"></i> Đang xử lý...');

        $.ajax({
          url: '/auth/login',          // endpoint NestJS (thay /auth/checkLogin của PHP)
          type: 'POST',
          data: $(this).serialize(),    // id=...&password=... (urlencoded, Nest tự parse vào DTO)
        })
          .done(function () {
            $err.removeClass('alert-danger').addClass('alert alert-success').text('Đăng nhập thành công').fadeIn();
            window.location.href = '/dashboard';
          })
          .fail(function (xhr) {
            const msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Đã xảy ra lỗi khi đăng nhập!';
            $err.removeClass('alert-success').addClass('alert alert-danger').text(msg).fadeIn();
          })
          .always(function () {
            $btn.prop('disabled', false);
            $text.html('Đăng nhập');
          });
      });
    });
  </script>
<script src="/public/js/auth-ui.js"></script>
</body></html>
