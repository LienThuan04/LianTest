<!DOCTYPE html>
<html lang="vi">
<head>
<%- include("../../partials/head") %>
<link rel="stylesheet" href="/public/css/auth.css">
</head>
<body class="auth-page">
<a class="skip-link" href="#auth-main">Đến biểu mẫu</a>
<div id="page-container" class="auth-layout">
<%- include("../../partials/auth-intro") %>
<main class="auth-panel" id="auth-main">
<h1>Tạo tài khoản sinh viên</h1><p>Dùng email @dht.edu.vn. Quyền sử dụng được cấp theo tài khoản.</p>
<form id="signupForm" method="POST" action="/auth/addUser">
      <div class="form-grid">
        <div class="auth-field"><label for="signup-masinhvien">Mã sinh viên</label><input id="signup-masinhvien" class="form-control" type="text" name="masinhvien" autocomplete="username" placeholder="Mã sinh viên" required></div>
        <div class="auth-field"><label for="signup-email">Email trường</label><input id="signup-email" class="form-control" type="email" name="email" autocomplete="email" placeholder="Địa chỉ Email" required></div>
        <div class="auth-field"><label for="signup-hoten">Họ và tên</label><input id="signup-hoten" class="form-control" type="text" name="hoten" autocomplete="name" placeholder="Họ và tên" required></div>
        <div class="auth-field"><label for="signup-ngaysinh">Ngày sinh</label><input id="signup-ngaysinh" class="form-control" type="date" name="ngaysinh" autocomplete="bday" required></div>
        <div class="auth-field"><label for="signup-gioitinh">Giới tính</label><select id="signup-gioitinh" class="form-select" name="gioitinh" required>
          <option value="" selected disabled>Giới tính</option><option value="1">Nam</option><option value="0">Nữ</option>
        </select></div>
        <div class="auth-field"><label for="signup-sodienthoai">Số điện thoại</label><input id="signup-sodienthoai" class="form-control" type="text" name="sodienthoai" autocomplete="tel" inputmode="tel" placeholder="Số điện thoại" required></div>
        <div class="auth-field"><label for="signup-password">Mật khẩu</label><input id="signup-password" class="form-control" type="password" autocomplete="new-password" name="password" placeholder="Mật khẩu" required></div>
        <div class="auth-field"><label for="signup-confirm_password">Xác nhận mật khẩu</label><input id="signup-confirm_password" class="form-control" type="password" autocomplete="new-password" name="confirm_password" placeholder="Nhập lại mật khẩu" required></div>
      </div>
      <div class="checkbox-container">
        <label><input type="checkbox" required> Tôi đồng ý với</label>
        <button type="button" class="terms-toggle" aria-haspopup="dialog" aria-controls="termsModal" onclick="document.getElementById('termsModal').style.display='flex';">chính sách và điều khoản</button>
      </div>
      <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
      <a href="/auth/signin" class="btn btn-secondary">Quay lại đăng nhập</a>
    </form>
    <!-- Terms Modal -->
    <div id="termsModal" class="modal" role="dialog" aria-hidden="true" tabindex="-1" aria-labelledby="termsModal-title">
      <div class="modal-content">
        <h2 id="termsModal-title">Điều khoản và Chính sách</h2>
        <div class="modal-body">
          <p><strong>1. Chấp nhận Điều khoản</strong><br>
            Bằng việc sử dụng dịch vụ của LianTest, bạn đồng ý tuân thủ các điều khoản và điều kiện được nêu trong tài liệu này. Nếu bạn không đồng ý, vui lòng không sử dụng dịch vụ.</p>
          <p><strong>2. Quyền và Nghĩa vụ</strong><br>
            - Bạn cam kết cung cấp thông tin chính xác và đầy đủ khi đăng ký tài khoản.<br>
            - Bạn chịu trách nhiệm bảo mật thông tin tài khoản và mật khẩu của mình.<br>
            - LianTest có quyền tạm ngưng hoặc hủy tài khoản nếu phát hiện hành vi vi phạm điều khoản.</p>
          <p><strong>3. Quyền riêng tư</strong><br>
            Thông tin cá nhân của bạn sẽ được bảo vệ theo Chính sách Bảo mật của chúng tôi. Chúng tôi chỉ thu thập và sử dụng thông tin theo mục đích cung cấp dịch vụ và tuân thủ pháp luật.</p>
          <p><strong>4. Giới hạn trách nhiệm</strong><br>
            LianTest không chịu trách nhiệm cho bất kỳ thiệt hại nào phát sinh từ việc sử dụng dịch vụ, bao gồm nhưng không giới hạn ở mất dữ liệu hoặc gián đoạn dịch vụ.</p>
          <p><strong>5. Thay đổi Điều khoản</strong><br>
            LianTest có quyền cập nhật hoặc thay đổi điều khoản này bất kỳ lúc nào. Các thay đổi sẽ được thông báo qua email hoặc trên nền tảng.</p>
        </div>
        <div class="modal-footer">
          <button class="close-btn" onclick="document.getElementById('termsModal').style.display='none'">Đóng</button>
        </div>
      </div>
    </div>

    <!-- Error Modal -->
    <div id="errorModal" class="modal" role="dialog" aria-hidden="true" tabindex="-1" aria-labelledby="errorModal-title">
      <div class="modal-content">
        <h2 id="errorModal-title">Lỗi Đăng Ký</h2>
        <div class="modal-body">
          <p id="errorMessage" class="error"></p>
        </div>
        <div class="modal-footer">
          <button class="close-btn" onclick="document.getElementById('errorModal').style.display='none'">Đóng</button>
        </div>
      </div>
    </div>
<p class="auth-footer"><a href="/">← Tìm hiểu LianTest</a></p>
</main></div>
<script>
  // Bê nguyên script kiểm tra phía client của signup.php; chỉ đổi đường dẫn
  // chuyển trang `./auth/signin` → `/auth/signin`.
  document.getElementById('signupForm').addEventListener('submit', async function (event) {
    event.preventDefault();
    const form = event.target;
    const formData = new FormData(form);
    const email = form.email.value;
    const ngaysinh = form.ngaysinh.value;
    const password = form.password.value;
    const confirmPassword = form.confirm_password.value;

    const today = new Date();
    const dob = new Date(ngaysinh);
    let age = today.getFullYear() - dob.getFullYear();
    const monthDiff = today.getMonth() - dob.getMonth();
    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
      age--;
    }

    const emailPattern = /^[a-zA-Z0-9._%+-]+@dht\.edu\.vn$/;
    if (!emailPattern.test(email)) {
      showError('Email phải đúng định dạng và có đuôi @dht.edu.vn');
      return;
    }
    if (dob > today) {
      showError('Ngày sinh không được là ngày trong tương lai');
      return;
    }
    if (age < 16) {
      showError('Bạn phải ít nhất 16 tuổi để đăng ký');
      return;
    }
    if (password !== confirmPassword) {
      showError('Mật khẩu và xác nhận mật khẩu không khớp');
      return;
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });
      const result = await response.json();

      if (result.status === 'success') {
        const successDiv = document.createElement('div');
        successDiv.className = 'message success';
        successDiv.style.textAlign = 'center';
        successDiv.style.margin = '20px 0';
        successDiv.innerHTML = `${result.message}<br>Chuyển trang sau <span id="countdown">5</span> giây.`;
        form.parentElement.insertBefore(successDiv, form);
        form.style.display = 'none';

        let seconds = 5;
        const countdown = setInterval(function () {
          if (seconds > 1) {
            seconds--;
            document.getElementById('countdown').textContent = seconds;
          } else {
            window.location.href = '/auth/signin';
            clearInterval(countdown);
          }
        }, 1000);
      } else {
        // Lỗi validate của NestJS trả {message, details:[{messages:[...]}]}
        showError(result.message || 'Đăng ký thất bại', result.details);
      }
    } catch (error) {
      showError('Đã xảy ra lỗi khi gửi yêu cầu. Vui lòng thử lại.');
    }
  });

  function showError(message, details) {
    let text = message;
    if (Array.isArray(details) && details.length) {
      text = details.flatMap((d) => d.messages || []).join(' ') || message;
    }
    document.getElementById('errorMessage').textContent = text;
    document.getElementById('errorModal').style.display = 'flex';
  }
</script>
<script src="/public/js/auth-ui.js"></script>
</body></html>
