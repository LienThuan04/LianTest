<!DOCTYPE html>
<html lang="vi">
<head>
<%- include("../../partials/head") %>
<link rel="stylesheet" href="/public/css/auth.css">
</head>
<body class="auth-page">
<a class="skip-link" href="#auth-main">Đến biểu mẫu</a>
<div id="page-container" class="auth-layout">
<%- include("../../partials/auth-intro") %>
<main class="auth-panel" id="auth-main">
<h1>Quên mật khẩu</h1><p>Nhập email của tài khoản để nhận mã xác minh.</p>
<form id="recoverForm" class="js-validation-reminder" method="POST" action="/auth/sendOptAuth" onsubmit="return false;">
            <label class="form-label" for="reminder-credential">Email tài khoản</label><div class="input-group">
              <span class="input-icon"><i class="fa fa-envelope"></i></span>
              <input type="email" id="reminder-credential" name="reminder-credential" autocomplete="email" class="form-control"
                placeholder="Nhập email của tài khoản" required>
            </div>

            <div class="d-grid gap-3">
              <button id="btnRecover" type="submit" class="btn btn-primary">
                <i class="fa fa-reply me-1"></i> Khôi phục mật khẩu
              </button>
              <a href="/auth/signin" class="btn btn-secondary">
                <i class="fa fa-sign-in-alt me-1"></i> Quay về đăng nhập
              </a>
            </div>
          </form>

<p class="auth-footer"><a href="/">← Tìm hiểu LianTest</a></p>
</main></div>
<%- include("../../partials/auth-scripts") %>

<script src="/public/js/auth-ui.js"></script>
</body></html>
