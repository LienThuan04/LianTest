<!DOCTYPE html>
<html lang="vi">
<head>
<%- include("../../partials/head") %>
<link rel="stylesheet" href="/public/css/auth.css">
</head>
<body class="auth-page">
<a class="skip-link" href="#auth-main">Đến biểu mẫu</a>
<div id="page-container" class="auth-layout">
<%- include("../../partials/auth-intro") %>
<main class="auth-panel" id="auth-main">
<h1>Đặt mật khẩu mới</h1><p>Nhập mật khẩu mới và xác nhận để tiếp tục.</p>
<form id="changepass" onsubmit="return false;">
        <div class="auth-field">
          <label for="passwordNew">Mật khẩu mới</label><input autocomplete="new-password" class="form-control" type="password" id="passwordNew" name="passwordNew" placeholder="Mật khẩu mới" required>
        </div>
        <div class="auth-field">
          <label for="comfirm">Xác nhận mật khẩu</label><input autocomplete="new-password" class="form-control" type="password" id="comfirm" name="comfirm" placeholder="Xác nhận mật khẩu" required>
        </div>
        <button id="btnChange" type="submit" class="btn btn-primary">Cập nhật</button>
        <a href="/auth/signin" class="btn btn-secondary">← Quay lại đăng nhập</a>
      </form>

<p class="auth-footer"><a href="/">← Tìm hiểu LianTest</a></p>
</main></div>
<%- include("../../partials/auth-scripts") %>

<script src="/public/js/auth-ui.js"></script>
</body></html>
