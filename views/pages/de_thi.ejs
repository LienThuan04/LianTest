<!DOCTYPE html>
<html lang="vi">
<head>
  <!-- base href="/" để de_thi.js (URL tương đối) resolve đúng từ /test/taketest/:made. -->
  <base href="/" />
  <%- include('../partials/head') %>
  <!-- Port từ DHT_OneTest/mvc/views/pages/de_thi.php: CKEditor 5 + idb (CDN như gốc). -->
  <script src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js"></script>
  <script src="https://unpkg.com/idb@7/build/umd.js"></script>

</head>
<body class="exam-page">
<div id="page-container">
<% const u = (typeof user !== 'undefined' && user) ? user : {}; %>
<nav class="nav-custom border-bottom bg-white  w-100 shadow-sm">
  <div class="container d-flex justify-content-between align-items-center py-3 position-relative">
    <!-- LEFT: TIME -->
    <div class="nav-left d-flex align-items-center">
      <div class="fs-5 text-dark">
        <i class="far fa-clock me-2"></i>Thời gian:
        <span id="timer" class="fw-bold">00:00:00</span>
      </div>
    </div>

    <!-- CENTER: INFO -->
    <div class="nav-center position-absolute start-50 translate-middle-x text-center">
      <div class="fs-5">
        <span class="fw-bold">Họ và Tên:</span>
        <span class="text-red"><%= u.hoten || '' %></span>
      </div>
      <div class="fs-6 mt-1">
        <span class="fw-bold">MSSV:</span>
        <span class="text-cyan"><%= u.id || '' %></span>
      </div>
      <div class="fs-6 mt-1 text-dark">
        <span class="fw-bold">Môn:</span>
        <span id="ten-mon" class="text-dark">Không rõ</span>
        &nbsp; | &nbsp;
        <span class="fw-bold">Tên Đề:</span>
        <span id="ten-de" class="text-dark">Không rõ</span>
      </div>
    </div>

    <!-- RIGHT: MODE + SUBMIT -->
    <div class="nav-right d-flex align-items-center gap-3 ms-auto">
      <div class="text-center me-2">
        <div class="fw-bold text-secondary" style="font-size: 0.85rem; margin-bottom: 4px;">Chế độ hiển thị</div>
        <div class="btn-group" role="group">
          <button type="button" id="mode-full" class="btn btn-outline-primary btn-sm active"><i class="fas fa-th-large"></i> Full</button>
          <button type="button" id="mode-one" class="btn btn-outline-success btn-sm"><i class="fas fa-file-alt"></i> Từng câu</button>
        </div>
      </div>
      <button id="btn-nop-bai" class="btn btn-primary btn-lg shadow-sm rounded-pill">
        <i class="far fa-file-lines me-1"></i> Nộp bài
      </button>
    </div>
  </div>
</nav>

<div class="container mb-5 mt-6" id="dethicontent"
     data-id="<%= typeof Made !== 'undefined' ? Made : '' %>"
     data-user="<%= u.id || '' %>">
  <div class="row">
    <div class="col-8" id="list-question">
      <!-- Question content goes here -->
    </div>
    <div class="col-4 d-flex justify-content-center">
      <div class="bg-white p-3 rounded border h-100 sidebar-answer">
        <ul class="answer">
          <!-- Answer list goes here -->
        </ul>
      </div>
    </div>
  </div>
</div>

</div>
<%- include('../partials/script') %>
<!-- Plugin trang Làm bài: sweetalert2 (Swal). -->
<script src="/public/js/plugins/sweetalert2/sweetalert2.all.min.js"></script>
<script src="/public/js/exam-essay-html.js"></script>
<script src="/public/js/pages/de_thi.js"></script>
</body>
</html>
